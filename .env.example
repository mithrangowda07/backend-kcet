PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kcet?retryWrites=true&w=majority
SECRET_KEY=django-insecure-change-this-in-production
MYSQL_DB_NAME=kcet
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Leave unset or set to "none" on buckets that disable ACLs (Object Ownership enforced)
AWS_S3_DEFAULT_ACL=

# SMTP (approval/rejection emails to college students)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=